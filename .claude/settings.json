{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh",
            "timeout": 90,
            "statusMessage": "oxlint / prettier / tsc を実行中..."
          }
        ]
      }
    ]
  }
}
